{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "docs/**",
      "README.md",
      ".git/**",
      "**/.git/**",
      ".firebase/**",
      "**/.firebase/**",
      ".firebaserc",
      ".gitignore",
      ".nojekyll",
      "serve.cjs",
      "**/.*",
      "**/node_modules/**",
      "*.log"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store" }
        ]
      }
    ],
    "cleanUrls": true
  }
}
